{
    "name": "imagewize/ssl-manager",
    "description": "Laravel package that issues and renews Let's Encrypt certificates for customer domains and generates their Nginx config",
    "keywords": ["laravel", "ssl", "letsencrypt", "lets-encrypt", "acme", "nginx", "certificates"],
    "homepage": "https://github.com/imagewize/ssl-manager",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Karabutin Alex",
            "email": "karabutin.alex@nexode.org"
        },
        {
            "name": "Imagewize",
            "homepage": "https://github.com/imagewize"
        }
    ],
    "autoload": {
        "psr-4": {
            "Imagewize\\SslManager\\": "src/"
        }
    },
     "extra": {
        "laravel": {
            "providers": [
                "Imagewize\\SslManager\\SslManagerProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "require": {
        "ext-curl": "*",
        "laravel/framework": "^10.0 || ^11.0 || ^12.0",
        "stonemax/acme2": "^1.0"
    }
}
